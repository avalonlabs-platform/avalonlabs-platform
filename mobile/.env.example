# Copy to .env.local and fill in real values. EXPO_PUBLIC_ vars get baked
# into the client bundle (same idea as Next.js's NEXT_PUBLIC_) — only put
# values here that are safe to ship in the app, never secrets.

# Same Supabase project as the web app (src/lib/supabase/*.ts) — the anon
# key is safe to expose, it's protected by RLS on the server.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the deployed Next.js API (avalonlabs-platform). Local dev
# against `npm run dev` needs your machine's LAN IP, not localhost —
# Expo Go runs on a physical device/emulator, not your dev machine.
EXPO_PUBLIC_API_BASE_URL=https://www.avalonlabs-platform.com
