{
  "expo": {
    "name": "AvalonLabs",
    "slug": "avalonlabs-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "avalonlabs",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.avalonlabs.mobile"
    },
    "android": {
      "package": "com.avalonlabs.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "AvalonLabs uses the camera to scan codes and photograph code, errors, and diagrams for instant analysis."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AvalonLabs uses your photo library to analyze screenshots of code, errors, and diagrams."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
