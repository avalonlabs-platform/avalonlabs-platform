{
  "expo": {
    "name": "AvalonLabs",
    "slug": "avalonlabs-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "avalonlabs",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.avalonlabs.mobile"
    },
    "android": {
      "package": "com.avalonlabs.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "AvalonLabs uses the camera to scan codes for instant analysis."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
