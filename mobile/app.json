{
  "expo": {
    "name": "AvalonLabs",
    "slug": "avalonlabs-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "avalonlabs",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.avalonlabs.mobile"
    },
    "android": {
      "package": "com.avalonlabs.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundColor": "#0d1117"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "AvalonLabs uses the camera to scan codes and photograph code, errors, and diagrams for instant analysis."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AvalonLabs uses your photo library to analyze screenshots of code, errors, and diagrams."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "backgroundColor": "#0d1117",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a223d2fe-15e2-4dce-a57d-4528de035f54"
      }
    }
  }
}
