# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.avalonlabs.example

# ---------------------------------------------------------------------------
# Supabase (auth + database)
# Get these from Supabase Dashboard > Project Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Paddle — Billing
# Get these from Paddle Dashboard > Developer Tools > Authentication
# Use sandbox keys/prices while developing, live keys only in production.
# NOTE: the value here must be the literal string "sandbox" or "production"
# (Paddle.js environment name) — NOT "live", which it will silently reject.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Client-side token, safe to expose to the browser.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Server-only. Used for API calls (transactions, customers, subscriptions).
PADDLE_API_KEY=
# Server-only. From the notification destination you create at
# Paddle > Developer Tools > Notifications (URL: <site>/api/webhooks/paddle).
# Subscribe to: transaction.completed, subscription.created,
# subscription.updated, subscription.canceled, customer.created,
# customer.updated. Sandbox and production need separate destinations with
# separate secrets — never share one between them.
PADDLE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Paddle — Price IDs
# Populate after running the catalog-setup skill / creating products in Paddle.
# Subscription tiers (monthly + yearly each):
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PADDLE_PRICE_STARTER_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_STARTER_YEAR=
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEAR=
NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_YEAR=

# One-time SaaS Microservice purchases:
NEXT_PUBLIC_PADDLE_PRICE_MS_PLAN_REVIEW=
NEXT_PUBLIC_PADDLE_PRICE_MS_CONTRACT=
NEXT_PUBLIC_PADDLE_PRICE_MS_SQL_OPTIMIZER=
NEXT_PUBLIC_PADDLE_PRICE_MS_SECURITY_AUDITOR=

# ---------------------------------------------------------------------------
# Resend — outbound email
# Get this from Resend Dashboard > API Keys. Used by /api/contact.
# The same key's SMTP credentials (host smtp.resend.com, user "resend",
# password = this API key) also fix Supabase's default email rate limit —
# see Supabase Dashboard > Authentication > Email > SMTP Settings.
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Anthropic — powers both AI chat surfaces: the auth-gated dashboard chat
# (src/app/api/chat, claude-sonnet-5) and the public homepage demo
# (src/app/api/demo-chat, claude-haiku-4-5, rate-limited per IP).
# Get this from console.anthropic.com > API Keys. Server-only, never expose
# to the client.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Google AI Studio (Gemini) — the auth-gated dashboard chat's second provider
# (src/app/api/chat, via src/lib/llm-router.ts). Used for large-context
# document/spec analysis (API Analyzer) and high-throughput vision/OCR
# (Vision Analyzer). Does NOT affect the public homepage demo, which stays
# Anthropic-only. Get this from Google AI Studio (aistudio.google.com) >
# Get API Key. Server-only, never expose to the client. If unset, agents
# mapped to Gemini automatically fall back to Anthropic.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Optional ops override for src/lib/llm-router.ts's resolveProvider(). Set to
# "anthropic" or "gemini" to force every request to that provider regardless
# of per-agent preference (e.g. as a kill-switch if one provider is degraded).
# Leave unset, or set to "auto", to use each agent's preferred provider.
DEFAULT_LLM_PROVIDER=
