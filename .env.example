# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.avalonlabs.example

# ---------------------------------------------------------------------------
# Supabase (auth + database)
# Get these from Supabase Dashboard > Project Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Paddle — Billing
# Get these from Paddle Dashboard > Developer Tools > Authentication
# Use sandbox keys/prices while developing, live keys only in production.
# NOTE: the value here must be the literal string "sandbox" or "production"
# (Paddle.js environment name) — NOT "live", which it will silently reject.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Client-side token, safe to expose to the browser.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Server-only. Used for API calls (transactions, customers, subscriptions).
PADDLE_API_KEY=
# Server-only. Used to verify incoming webhook signatures.
PADDLE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Paddle — Price IDs
# Populate after running the catalog-setup skill / creating products in Paddle.
# Subscription tiers (monthly + yearly each):
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PADDLE_PRICE_STARTER_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_STARTER_YEAR=
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEAR=
NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_YEAR=

# One-time SaaS Microservice purchases:
NEXT_PUBLIC_PADDLE_PRICE_MS_PLAN_REVIEW=
NEXT_PUBLIC_PADDLE_PRICE_MS_CONTRACT=
