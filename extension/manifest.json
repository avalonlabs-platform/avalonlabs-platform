{
  "manifest_version": 3,
  "name": "AvalonLabs Assistant",
  "version": "1.1.1",
  "description": "Chat with AvalonLabs AI agents from a persistent side panel, or select text on any page for instant Explain/Audit/Review actions.",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open AvalonLabs Assistant"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Command+Shift+A"
      },
      "description": "Open the AvalonLabs side panel"
    }
  },
  "permissions": ["sidePanel", "activeTab", "scripting", "storage", "contextMenus", "notifications"],
  "host_permissions": ["https://www.avalonlabs-platform.com/*"]
}
